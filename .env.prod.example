# ===== Producción (VPS) — copia a .env.prod y edita =====

# Dominio con HTTPS (ya resuelve a tu VPS)
DOMAIN=flota.simarp.net

# Puerto local donde escucha la web dentro del VPS (tu nginx enruta aquí).
# Evita 8090 si usas CyberPanel; 8095 suele estar libre.
WEB_BIND=8095

# Base de datos — usa una contraseña fuerte
POSTGRES_USER=flota
POSTGRES_PASSWORD=CAMBIA_esta_password_larga
POSTGRES_DB=control_flota

# Secreto JWT — genera uno aleatorio, p. ej.:  openssl rand -hex 32
JWT_SECRET=CAMBIA_por_un_secreto_de_64_hex

# Ruteo (OSRM propio). Prepara los datos con scripts/osrm-prepare.sh en el VPS.
OSRM_URL=http://osrm:5000
OSRM_PBF=valparaiso-latest

# Motor de ruteo: 'osrm' (gratis, OpenStreetMap) o 'google' (mejores datos, requiere key)
ROUTING_PROVIDER=osrm
# Solo si usas Google: crea la key en Google Cloud → habilita "Directions API"
GOOGLE_MAPS_API_KEY=

# Cuenta admin inicial (solo se usa al sembrar una base vacía).
# Si no defines la clave, en producción se genera una aleatoria y se imprime
# UNA vez en el log del contenedor api. Nunca se crean cuentas demo en prod.
SEED_ADMIN_EMAIL=admin@flota.cl
SEED_ADMIN_PASSWORD=
