# ---- Base de datos (PostgreSQL + PostGIS) ----
POSTGRES_USER=flota
POSTGRES_PASSWORD=flota_pass
POSTGRES_DB=control_flota
DB_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- API ----
NODE_ENV=production
API_PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
CORS_ORIGIN=http://localhost:8080

# ---- Web (build-time) ----
WEB_PORT=8080
VITE_API_URL=http://localhost:4000

# ---- Ruteo (OSRM) ----
# Con OSRM propio (recomendado): descomenta OSRM_URL tras preparar los datos.
#   ./scripts/osrm-prepare.sh https://download.openstreetmap.fr/extracts/south-america/chile/valparaiso-latest.osm.pbf
#   docker compose --profile routing up -d osrm
# OSRM_URL=http://osrm:5000
#
# Sin configurar, usa el servidor público de OSRM (solo demo, con límites de uso):
OSRM_URL=https://router.project-osrm.org
OSRM_PORT=5001
# Nombre base del extracto OSM preprocesado (sin extensión). Ver scripts/osrm-prepare.sh
OSRM_PBF=valparaiso-latest
# Radio máx. (m) para encajar un punto a la red vial; fuera de eso, línea recta
OSRM_SNAP_RADIUS_M=3000

# Para desarrollo con hot-reload usa: BUILD_TARGET=development NODE_ENV=development
BUILD_TARGET=production
